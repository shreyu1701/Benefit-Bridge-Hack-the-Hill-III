# --- Database (Tiger Data / PostgreSQL). Use sslmode=require for Tiger Cloud.
DATABASE_URL=postgres://user:password@host:5432/benefit_bridge?sslmode=require

# --- Google Gemini (fact extraction, translation, summaries, change-review drafts)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- ElevenLabs (speech-to-text input, multilingual text-to-speech)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# --- Auth0 (optional: "Sign in with Google" to save a profile, + reviewer accounts).
# Leave these empty and everyone is a guest. Setup steps: README → "Sign in with Google".
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=            # openssl rand -hex 32
APP_BASE_URL=http://localhost:3000
AUTH0_GOOGLE_CONNECTION=google-oauth2   # Auth0's name for the Google social connection
ADMIN_EMAILS=reviewer@example.org

# Local development only (ignored when NODE_ENV=production): reviewer access without Auth0.
ADMIN_TOKEN=

# --- Encrypts saved profiles (AES-256-GCM): 32 random bytes, base64 (openssl rand -base64 32).
# Required for signed-in users; guests' profiles never reach the server.
PROFILE_ENCRYPTION_KEY=

# --- Worker politeness / schedules
FETCH_USER_AGENT="BenefitBridgeBot/0.1 (+https://your-domain.example; contact@your-domain.example)"
FETCH_MIN_INTERVAL_MS=2000
LEGISINFO_INTERVAL_MIN=30
OLA_INTERVAL_MIN=60
