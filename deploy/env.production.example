# Copy to .env.production on the server (never commit the real file).
#   cp deploy/env.production.example .env.production && nano .env.production

# --- Site
SITE_DOMAIN=203-0-113-5.sslip.io          # your domain, or <server-ip-with-dashes>.sslip.io
APP_BASE_URL=https://203-0-113-5.sslip.io # same host, with https://

# --- Database (container on the same server). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# --- ElevenLabs (voice). Free plan: use a built-in voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# --- Auth0 (Sign in with Google). Leave empty to run guest-only.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=                 # openssl rand -hex 32   (a NEW one for production)
ADMIN_EMAILS=

# --- Encrypts saved profiles. openssl rand -base64 32  (a NEW one for production; keep a copy safe:
# losing it makes saved profiles unreadable)
PROFILE_ENCRYPTION_KEY=

# --- Ingestion worker
FETCH_USER_AGENT="BenefitBridgeBot/0.1 (+https://203-0-113-5.sslip.io)"
FETCH_MIN_INTERVAL_MS=2000
