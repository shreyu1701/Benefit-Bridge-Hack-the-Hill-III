# Copy to .env.worker on the Vultr server:  cp deploy/env.worker.example .env.worker && nano .env.worker

# --- Managed Postgres. The worker holds a session-level lock, so use a SESSION connection:
#     Supabase: Project → Connect → "Session pooler" (port 5432), then add ?sslmode=require
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ca-central-1.pooler.supabase.com:5432/postgres?sslmode=require
# Supabase: Project Settings → Database → SSL Configuration → Download certificate,
# then paste its contents on ONE line with \n between lines (or leave empty and use ?sslmode=no-verify).
DATABASE_CA_CERT=

# --- Gemini (writes plain-language bill summaries and change-review drafts)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# --- Politeness when fetching government sites
FETCH_USER_AGENT="BenefitBridgeBot/0.1 (+https://benefit-bridge-hack-the-hill-iii.vercel.app)"
FETCH_MIN_INTERVAL_MS=2000
LEGISINFO_INTERVAL_MIN=30
OLA_INTERVAL_MIN=60

# Bills drafted per hour for the "who does this bill affect" review queue (1 Gemini request each).
# Keep it small on the Gemini free tier, which is shared with the website.
BILL_IMPACT_BATCH=5
